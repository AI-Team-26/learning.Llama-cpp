{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "📥 GIT Fetch",
            "type": "shell",
            "command": "git fetch --prune origin",
            "group": "none"
        },
        {
            "label": "➕ GIT push TODO task",
            "type": "shell",
            "command": "git add TODO.md && git commit -m 'todo: add task' && git push --force",
            "group": "none"
        },
        {
            "label": "🧪 Test Models",
            "type": "shell",
            "command": "./test_models.sh",
            "group": "build",            
            "options": {
                "cwd": "${workspaceFolder}/scripts"
            },
        },
        {
            "label": "▶️ Run Server",
            "type": "shell",
            "command": "./run_server.sh",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/scripts"
            },
        },
        {
            "label": "🛠️ Update Llama.cpp",
            "type": "shell",
            "command": "python UpdateLlamaCpp.py",
            "group": "build",
            "options": {
                "cwd": "${workspaceFolder}/scripts"
            },
        }
    ]
}